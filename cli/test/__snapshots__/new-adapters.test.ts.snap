  ".gemini/hooks/groundwork.mjs": "// Groundwork hook script for Gemini CLI. Generated by Groundwork; edit .groundwork/hooks/ instead.
// Usage: node .gemini/hooks/groundwork.mjs <session-start|stop|pre-compress|session-end>
// It runs .groundwork/hooks/session-start.mjs and checkpoint.mjs and returns their text in the JSON
// Gemini CLI reads (SessionStart hookSpecificOutput.additionalContext and AfterAgent decision/reason: geminicli.com/docs/hooks/reference).
import { execFileSync } from "node:child_process";
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";
import { fileURLToPath } from "node:url";

// This file lives in <project>/.gemini/hooks/, so the project is two folders up.
const project = fileURLToPath(new URL("../../", import.meta.url));
const TOOL = "gemini";

const REPLY = {
  "session-start": (text) => (text ? { hookSpecificOutput: { hookEventName: "SessionStart", additionalContext: text } } : {}),
  "stop": (text) => (text ? { decision: "deny", reason: text } : {}),
  "pre-compress": (text) => ({}),
  "session-end": (text) => ({}),
};

function hookInput() {
  try {
    return JSON.parse(readFileSync(0, "utf8").replace(/^\\uFEFF/, "") || "{}");
  } catch {
    return {};
  }
}

const out = (value) => process.stdout.write(JSON.stringify(value) + "\\n");

// Runs one of Groundwork's hook scripts with the hook's input on stdin; "" if it says nothing or fails.
function run(script, args, input) {
  const file = join(project, ".groundwork", "hooks", script);
  if (!existsSync(file)) return "";
  try {
    return execFileSync(process.execPath, [file, ...args], {
      input: JSON.stringify(input),
      encoding: "utf8",
      timeout: 10000,
      windowsHide: true,
      stdio: ["pipe", "pipe", "ignore"],
    }).trim();
  } catch {
    return "";
  }
}

async function main() {
  const event = process.argv[2] ?? "";
  const raw = hookInput();
  const input = raw;

  const reply = REPLY[event];
  if (!reply) return;
  try {
    const text = event === "session-start" ? run("session-start.mjs", [project, TOOL], input) : run("checkpoint.mjs", [event === "pre-compress" ? "pre-compact" : event, project, TOOL], input);
    out(reply(event === "session-start" || event === "stop" ? text : ""));
  } catch {
    // a hook never stops the tool
  }
}

if (process.argv[1] && fileURLToPath(import.meta.url) === process.argv[1]) await main();
",
  ".gemini/settings.json": "{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "groundwork-session-start",
            "type": "command",
            "command": "node .gemini/hooks/groundwork.mjs session-start",
            "timeout": 15000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "groundwork-stop",
            "type": "command",
            "command": "node .gemini/hooks/groundwork.mjs stop",
            "timeout": 15000
          }
        ]
      }
    ],
    "PreCompress": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "groundwork-pre-compress",
            "type": "command",
            "command": "node .gemini/hooks/groundwork.mjs pre-compress",
            "timeout": 15000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "groundwork-session-end",
            "type": "command",
            "command": "node .gemini/hooks/groundwork.mjs session-end",
            "timeout": 10000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": "run_shell_command|write_file|replace",
        "hooks": [
          {
            "name": "groundwork-guards",
            "type": "command",
            "command": "node .groundwork/guards/run.mjs gemini",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
",
  "GEMINI.md": "@AGENTS.md

## Gemini CLI
Each session starts with the project brief from .groundwork/ (a hook adds it). /gw resumes from it and saves.
",
}
`;
