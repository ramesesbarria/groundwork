exports[`cursor adapter > matches the snapshot, context only and with the flow > context 1`] = `
{
  ".cursor/hooks.json": "{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/groundwork.mjs session-start",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/groundwork.mjs stop",
        "timeout": 15
      }
    ],
    "preCompact": [
      {
        "command": "node .cursor/hooks/groundwork.mjs pre-compact",
        "timeout": 15
      }
    ],
    "sessionEnd": [
      {
        "command": "node .cursor/hooks/groundwork.mjs session-end",
        "timeout": 10
      }
    ]
  }
}
",
  ".cursor/hooks/groundwork.mjs": "// Groundwork hook script for Cursor. Generated by Groundwork; edit .groundwork/hooks/ instead.
// Usage: node .cursor/hooks/groundwork.mjs <session-start|stop|pre-compact|session-end>
// It runs .groundwork/hooks/session-start.mjs and checkpoint.mjs and returns their text in the JSON
// Cursor reads (sessionStart additional_context and stop followup_message: cursor.com/docs/hooks; beforeShellExecution permission, user_message, agent_message: cursor.com/docs/hooks).
import { execFileSync } from "node:child_process";
import { existsSync, readFileSync } from "node:fs";
import { join } from "node:path";
import { fileURLToPath } from "node:url";

// This file lives in <project>/.cursor/hooks/, so the project is two folders up.
const project = fileURLToPath(new URL("../../", import.meta.url));
const TOOL = "cursor";

const REPLY = {
  "session-start": (text) => (text ? { additional_context: text } : {}),
  "stop": (text) => (text ? { followup_message: text } : {}),
  "pre-compact": (text) => ({}),
  "session-end": (text) => ({}),
};

function hookInput() {
  try {
    return JSON.parse(readFileSync(0, "utf8").replace(/^\\uFEFF/, "") || "{}");
  } catch {
    return {};
  }
}

const out = (value) => process.stdout.write(JSON.stringify(value) + "\\n");

// Runs one of Groundwork's hook scripts with the hook's input on stdin; "" if it says nothing or fails.
function run(script, args, input) {
  const file = join(project, ".groundwork", "hooks", script);
  if (!existsSync(file)) return "";
  try {
    return execFileSync(process.execPath, [file, ...args], {
      input: JSON.stringify(input),
      encoding: "utf8",
      timeout: 10000,
      windowsHide: true,
      stdio: ["pipe", "pipe", "ignore"],
    }).trim();
  } catch {
    return "";
  }
}

async function main() {
  const event = process.argv[2] ?? "";
  const raw = hookInput();
  const input = { ...raw, session_id: raw.session_id ?? raw.conversation_id, stop_hook_active: Number(raw.loop_count) > 0 };

  const reply = REPLY[event];
  if (!reply) return;
  try {
    const text = event === "session-start" ? run("session-start.mjs", [project, TOOL], input) : run("checkpoint.mjs", [event === "pre-compress" ? "pre-compact" : event, project, TOOL], input);
    out(reply(event === "session-start" || event === "stop" ? text : ""));
  } catch {
    // a hook never stops the tool
  }
}

if (process.argv[1] && fileURLToPath(import.meta.url) === process.argv[1]) await main();
",
  ".cursor/skills/gw-approve/SKILL.md": "---
