{
  "name": "groundwork-ai",
  "version": "0.6.0",
  "description": "A tool-agnostic workflow for building software with AI agents: spec, plan, test-first build loop, human-approved ship.",
  "keywords": [
    "ai-agents",
    "agentic",
    "claude-code",
    "opencode",
    "agents-md",
    "developer-workflow",
    "spec-driven",
    "tdd"
  ],
  "author": "Rameses Barria",
  "license": "MIT",
  "homepage": "https://github.com/ramesesbarria/groundwork#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramesesbarria/groundwork.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/ramesesbarria/groundwork/issues"
  },
  "type": "module",
  "bin": {
    "groundwork": "dist/bin.js"
  },
  "files": [
    "dist",
    "core"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && vitest run",
    "prepack": "npm run build && node scripts/copy-core.mjs",
    "postpack": "node scripts/copy-core.mjs --clean"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
