{
  "name": "groundwork-ai",
  "version": "2.0.0",
  "description": "Project memory for coding agents: a handoff stamped against git, a codebase map, decisions and lessons in your repo, so any session, tool or model resumes where the last one stopped. Optional build flow with cards and approval before each commit.",
  "keywords": [
    "ai-agents",
    "agentic",
    "agent-memory",
    "project-memory",
    "context-management",
    "handoff",
    "claude-code",
    "opencode",
    "agents-md",
    "developer-workflow",
    "spec-driven",
    "tdd"
  ],
  "author": "Rameses Barria",
  "license": "MIT",
  "homepage": "https://ramesesbarria.github.io/groundwork/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramesesbarria/groundwork.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/ramesesbarria/groundwork/issues"
  },
  "type": "module",
  "bin": {
    "groundwork": "dist/bin.js"
  },
  "files": [
    "dist",
    "core"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && vitest run",
    "test:coverage": "tsc -p tsconfig.json && vitest run --coverage",
    "prepack": "npm run build && node scripts/copy-core.mjs",
    "postpack": "node scripts/copy-core.mjs --clean"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@vitest/coverage-v8": "^5.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
